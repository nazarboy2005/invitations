DATABASE_URL=
APP_URL=http://127.0.0.1:3001
# Turnstile: only the site key is public. Hostnames are exact, without scheme/port.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Production example: TURNSTILE_HOSTNAMES=fotiha.uz,www.fotiha.uz
# Apply payment migrations and configure Nodze before customer testing.
# Set free explicitly only when intentionally offering free publication.
NODZE_API_BASE_URL=https://payments.nodze.org/api/v1
NODZE_API_KEY=
NODZE_WEBHOOK_SECRET=
# Return URL is exactly APP_URL/payment/return (no query string or trailing slash).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Fotiha_Taklifnoma_bot
# Optional: enable only after BotFather's Main Mini App points to APP_URL.
# Otherwise payment returns open the chat containing the automatic confirmation.
TELEGRAM_MAIN_MINI_APP_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
# Separate bot used only for support messages; its webhook is /api/support/telegram/webhook.
SUPPORT_TELEGRAM_BOT_TOKEN=
# Optional Telegram sticker file_ids. Obtain each file_id from a sticker sent
# to this bot; omitted values simply skip the decorative sticker.
TELEGRAM_WISH_STICKER_ID=
SESSION_SECRET=
# Server-only numeric Telegram user IDs, separated by commas. Never use NEXT_PUBLIC_.
# Example: 123456789,987654321. Existing verified accounts are supported.
# Restart/redeploy the web app AND Telegram/broadcast workers after changing this.
# Database-assigned admin roles remain independent of this allowlist.
PLATFORM_ADMIN_TELEGRAM_IDS=
# Optional authorization for internal cron endpoints, including guest notifications (minimum 32 characters).
# Set through server secrets; never place the value in a browser or URL.
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Development uses local disk by default without R2. Production requires R2,
# or explicit local storage on a persistent self-hosted server (never Vercel).
MEDIA_STORAGE=
# Use an absolute path when MEDIA_STORAGE=local. Keep it outside public/.
LOCAL_MEDIA_DIR=
# Optional storage/submission budgets; defaults shown. Server-only.
MEDIA_ACCOUNT_MAX_BYTES=1073741824
MEDIA_DAILY_UPLOAD_LIMIT=300
RECEIPTS_PER_INVITATION_MINUTE=60
SUBMISSIONS_PER_INVITATION_MINUTE=300
SUBMISSIONS_PER_INVITATION_DAY=10000
# Static invitation previews and PNG exports still need Chromium.
# Install on the application host: pnpm --filter @taklifnoma/web exec playwright install --with-deps chromium
# Optional absolute Chromium executable path, otherwise Playwright's installed browser.
INVITATION_COVER_BROWSER_PATH=
# Browser-visible JavaScript API key; restrict to your app's origins in Yandex Developer Dashboard.
YANDEX_MAPS_JAVASCRIPT_API_KEY=
# Server-only keys. Never expose these to templates or browser bundles.
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOSUGGEST_API_KEY=
