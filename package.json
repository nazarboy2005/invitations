{
  "name": "taklifnoma",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @taklifnoma/web dev",
    "build": "pnpm --filter @taklifnoma/web build",
    "typecheck": "pnpm --filter @taklifnoma/web typecheck",
    "test": "tsx --test tests/*.test.ts apps/web/src/modules/studio/draft-storage.test.ts apps/web/src/modules/catalog/*.test.ts",
    "test:publishing": "node --env-file=apps/web/.env.local --import tsx --test tests/publishing.test.ts tests/publishing.integration.ts",
    "test:payments": "node --env-file=apps/web/.env.local --import tsx --test tests/payments.test.ts tests/payments.integration.ts",
    "test:payments:http": "node --env-file=apps/web/.env.local --import tsx --test tests/payments-http.integration.ts",
    "test:admin": "node --env-file=apps/web/.env.local --import tsx --test tests/admin-security.test.ts tests/admin-allowlist.test.ts tests/admin-audit.test.ts tests/admin-management.test.ts tests/mini-app-admin-entry.test.ts tests/admin-security.integration.ts tests/admin-management.integration.ts tests/admin-allowlist.integration.ts tests/mini-app-identity.integration.ts",
    "telegram:poll": "node --env-file=apps/web/.env.local --import tsx scripts/telegram-poll.mts",
    "telegram:wishes": "node --env-file=apps/web/.env.local --import tsx scripts/telegram-poll.mts --deliver-wishes",
    "telegram:broadcasts": "node --env-file=apps/web/.env.local --import tsx scripts/admin-broadcasts.mts",
    "telegram:poll:with-wishes": "node --env-file=apps/web/.env.local --import tsx scripts/telegram-poll.mts --with-wish-notifications",
    "db:migrate": "node --env-file-if-exists=apps/web/.env.local --import tsx packages/database/src/migrate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.10.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
