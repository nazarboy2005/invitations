{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-chorlove-cloud-castle/types/**/*.ts",
    ".next-chorlove-cloud-castle/dev/types/**/*.ts",
    ".next-chorlove-cloud-castle-final/types/**/*.ts",
    ".next-chorlove-cloud-castle-final/dev/types/**/*.ts",
    ".next-chorlove-cloud-castle-rc2/types/**/*.ts",
    ".next-chorlove-cloud-castle-rc2/dev/types/**/*.ts",
    ".next-chorlove-cloud-castle-release/types/**/*.ts",
    ".next-chorlove-cloud-castle-release/dev/types/**/*.ts",
    ".next-chorlove-cloud-castle-dev/types/**/*.ts",
    ".next-chorlove-cloud-castle-dev/dev/types/**/*.ts",
    ".next-glass-pink-dev/types/**/*.ts",
    ".next-glass-pink-dev/dev/types/**/*.ts",
    ".next-release-golden-local/types/**/*.ts",
    ".next-release-golden-local/dev/types/**/*.ts",
    ".next-build-golden/types/**/*.ts",
    ".next-build-golden/dev/types/**/*.ts",
    ".next-release-garden/types/**/*.ts",
    ".next-release-garden/dev/types/**/*.ts",
    ".next-einv-qa/types/**/*.ts",
    ".next-einv-qa/dev/types/**/*.ts",
    ".next-green-gold-qa/types/**/*.ts",
    ".next-green-gold-qa/dev/types/**/*.ts",
    ".next-gulli-qa/types/**/*.ts",
    ".next-gulli-qa/dev/types/**/*.ts",
    ".next-einv-template-release-final/dev/types/**/*.ts",
    ".next-einv-template-release-check2/dev/types/**/*.ts",
    ".next-einv-template-release-check3/types/**/*.ts",
    ".next-einv-template-release-check3/dev/types/**/*.ts",
    ".next-einv-template-release-check4/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
